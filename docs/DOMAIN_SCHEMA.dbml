// Wilson Shipwrecked — Functional Domain Schema Projection
//
// Visualization aid for DOMAIN_MODEL.md + DOMAIN_VOCABULARY.md.
// NOT a persistence/database mandate. Maps/value objects are flattened only to
// make ownership/cardinality/identity visible. Concrete runtime schema versions
// belong to DISCOVERY_STATUS.md and implementation code.

Table run_state {
  run_id varchar [pk]
  seed varchar
  simulation_time decimal
  lifecycle varchar
  player_run_state_id varchar
}

Table player_profile {
  player_profile_id varchar [pk]
}

Table player_run_state {
  player_run_state_id varchar [pk]
  god_power decimal
  non_intervention_progress decimal
  game_mode varchar
}

// ---- Typed authored physical/content semantics ----

Table property_definition {
  property_id varchar [pk]
  value_family varchar // NUMBER | BOOLEAN | SYMBOL | future admitted typed family
  min_value_repr varchar [null]
  max_value_repr varchar [null]
}

Table entity_definition {
  entity_type_id varchar [pk]
  actor_profile_id varchar [null]
}

Table entity_definition_category {
  entity_type_id varchar
  category_id varchar
  indexes { (entity_type_id, category_id) [pk] }
}

Table entity_definition_capability {
  entity_type_id varchar
  capability_id varchar
  indexes { (entity_type_id, capability_id) [pk] }
}

Table entity_definition_property {
  entity_type_id varchar
  property_id varchar
  value_repr varchar
  indexes { (entity_type_id, property_id) [pk] }
}

// Ordinary WorldEvent semantic/perceptual definition, not Director lifecycle.
Table event_definition {
  event_definition_id varchar [pk]
  base_confidence decimal
}

Table event_perceptible_role {
  event_definition_id varchar
  role_id varchar
  indexes { (event_definition_id, role_id) [pk] }
}

Table event_modality {
  event_definition_id varchar
  modality_id varchar
  indexes { (event_definition_id, modality_id) [pk] }
}

Table action_definition {
  action_id varchar [pk]
  interruption_class varchar // PRE_COMMIT_ONLY | NEVER | ANYTIME
  requirement_root_id varchar
}

Table action_role_definition {
  action_id varchar
  role_id varchar
  ordinal int
  indexes { (action_id, role_id) [pk] }
}

Table action_resolution_definition {
  resolution_definition_id varchar [pk]
  action_id varchar
  duration decimal
  commit_fraction decimal
  event_definition_id varchar
}

Table action_resolution_effect {
  resolution_definition_id varchar
  ordinal int
  effect_kind varchar
  subject_role_id varchar
  semantic_id varchar
  value_repr varchar [null] // property value OR relation qualifier
  object_role_id varchar [null]
  indexes { (resolution_definition_id, ordinal) [pk] }
}

// Requirement nodes use bounded predicate families from DOMAIN_CATALOGS.md.
Table requirement_node {
  requirement_node_id varchar [pk]
  predicate_kind varchar
  role_id varchar [null]
  semantic_id varchar [null]
  comparison_operator varchar [null]
  literal_repr varchar [null]
  object_role_id varchar [null]
  registered_context_family varchar [null]
}

Table requirement_edge {
  parent_requirement_id varchar
  child_requirement_id varchar
  ordinal int
  indexes { (parent_requirement_id, child_requirement_id, ordinal) [pk] }
}

Table assembly_definition {
  assembly_definition_id varchar [pk]
}

Table assembly_slot_definition {
  assembly_definition_id varchar
  assembly_slot_id varchar
  assembly_role_id varchar
  accepted_component_requirement_root_id varchar
  min_count int
  max_count int
  optional boolean
  indexes { (assembly_definition_id, assembly_slot_id) [pk] }
}

Table property_derivation_definition {
  derivation_id varchar [pk]
  output_property_id varchar
  policy_id varchar
}

Table property_derivation_input {
  derivation_id varchar
  ordinal int
  selector_kind varchar // self | assembly_slot | future bounded selector
  property_id varchar
  assembly_slot_id varchar [null]
  indexes { (derivation_id, ordinal) [pk] }
}

Table interaction_rule_definition {
  interaction_rule_id varchar [pk]
  action_id varchar
  requirement_root_id varchar
  resolution_spec_id varchar
  discovery_spec_id varchar [null]
}

Table transformation_definition {
  transformation_id varchar [pk]
  source_requirement_root_id varchar
  result_entity_type_id varchar
  transfer_policy_id varchar
}

Table transformation_trigger_tag {
  transformation_id varchar
  semantic_outcome_tag varchar
  indexes { (transformation_id, semantic_outcome_tag) [pk] }
}

// ---- Authoritative World state ----

Table entity_instance {
  entity_id varchar [pk]
  run_id varchar
  entity_type_id varchar
  place_id varchar
  lifecycle varchar
  quantity decimal [null]
}

Table entity_state_override {
  entity_id varchar
  property_id varchar
  value_repr varchar
  indexes { (entity_id, property_id) [pk] }
}

Table place_state {
  place_id varchar
  run_id varchar
  region_id varchar [null]
  indexes { (run_id, place_id) [pk] }
}

Table wilson_world_state {
  run_id varchar [pk]
  place_id varchar
}

// RelationDefinition describes admissibility; exact relation identity additionally
// includes qualifier. Relation indexes/projections are reconstructible.
Table relation_definition {
  relation_type_id varchar [pk]
  cardinality varchar [null]
  inverse_relation_type_id varchar [null]
  exclusive_group_id varchar [null]
  symmetric boolean
  transitive boolean
}

Table relation_subject_kind {
  relation_type_id varchar
  subject_kind varchar
  indexes { (relation_type_id, subject_kind) [pk] }
}

Table relation_object_kind {
  relation_type_id varchar
  object_kind varchar
  indexes { (relation_type_id, object_kind) [pk] }
}

Table world_relation {
  relation_key varchar [pk] // canonical type+subject+object+qualifier identity
  run_id varchar
  relation_type_id varchar
  subject_kind varchar
  subject_id varchar
  object_kind varchar
  object_id varchar
  qualifier_value_repr varchar [null] // bounded PropertyValue / typed semantic ID
}

Table wilson_body_state {
  run_id varchar [pk]
  alive boolean
  vitality decimal
  exertion decimal
  wetness decimal
  mobility_state varchar
}

Table body_condition {
  condition_instance_id varchar [pk]
  run_id varchar
  condition_id varchar
  severity decimal
  source_subject_kind varchar [null]
  source_subject_id varchar [null]
  started_at decimal
  recovery_policy_id varchar
}

Table environment_state {
  run_id varchar [pk]
  weather_state_id varchar
  daylight_phase varchar
}

Table environmental_process {
  process_id varchar [pk]
  run_id varchar
  process_kind_id varchar
  subject_kind varchar
  subject_id varchar
  started_at decimal
}

Table actor_profile_definition {
  actor_profile_id varchar [pk]
  persistence_class varchar
}

Table actor_runtime_state {
  entity_id varchar [pk]
  run_id varchar
  actor_profile_id varchar
  current_activity_id varchar [null]
  target_subject_kind varchar [null]
  target_subject_id varchar [null]
}

// AssemblyBindingProjection and CompositionDependencyProjection are deliberately
// not persisted here; they reconstruct from qualified WorldRelation state.

// ---- Wilson Cognition ----

Table wilson_trait_profile {
  run_id varchar [pk]
  curiosity decimal
  risk_tolerance decimal
  independence decimal
}

Table wilson_drive_state {
  run_id varchar [pk]
  hunger_urgency decimal
  energy_need decimal
  discomfort decimal
  stimulation_need decimal
}

Table presence_relationship {
  run_id varchar [pk]
  presence_belief decimal
  trust decimal
  dependency decimal
}

// Durable epistemic identity is a CLOSED typed claim, not predicate+argument bag.
Table epistemic_claim {
  claim_key varchar [pk]
  claim_kind varchar // PROPERTY | RELATION | EVENT | future explicitly admitted kind
  subject_kind varchar
  subject_id varchar
  semantic_id varchar // PropertyId | RelationTypeId | EventDefinitionId by claim_kind
  value_repr varchar [null] // PROPERTY only
  object_kind varchar [null] // RELATION only
  object_id varchar [null]
  perceived_role_id varchar [null] // EVENT only
}

Table belief_entry {
  run_id varchar
  claim_key varchar
  confidence decimal
  evidence_count int
  last_source_execution_id varchar [null]
  last_modality_id varchar [null]
  indexes { (run_id, claim_key) [pk] }
}

// EpistemicGraphProjection is reconstructible from belief_entry + epistemic_claim.

Table knowledge_definition {
  knowledge_id varchar [pk]
  known_confidence_threshold decimal
  legacy_eligible boolean
  legacy_weight decimal
}

Table knowledge_claim_pattern {
  knowledge_id varchar
  ordinal int
  claim_kind varchar
  pattern_repr varchar
  indexes { (knowledge_id, ordinal) [pk] }
}

Table learned_semantic_interaction {
  knowledge_id varchar [pk]
  intention_id varchar
  applicability_requirement_root_id varchar
}

Table association_entry {
  run_id varchar
  subject_kind varchar
  subject_id varchar
  valence decimal
  attachment decimal
  indexes { (run_id, subject_kind, subject_id) [pk] }
}

Table habit_entry {
  habit_id varchar [pk]
  run_id varchar
  cue_id varchar
  intention_id varchar
  subject_pattern_repr varchar [null]
  strength decimal
}

Table episode {
  episode_id varchar [pk]
  run_id varchar
  simulation_time decimal
  event_definition_id varchar [null]
  context_place_id varchar [null]
  importance decimal
  source_accessibility varchar
  expected_outcome_repr varchar [null]
  observed_outcome_repr varchar
  meaningful_choice_repr varchar [null]
}

Table episode_subject {
  episode_id varchar
  ordinal int
  subject_kind varchar
  subject_id varchar
  indexes { (episode_id, ordinal) [pk] }
}

Table intention_instance {
  intention_id varchar [pk]
  run_id varchar
  semantic_intention_id varchar
  lifecycle varchar
  origin varchar
  commitment varchar
  started_at decimal
}

Table intention_binding {
  intention_id varchar
  role_id varchar
  subject_kind varchar
  subject_id varchar
  indexes { (intention_id, role_id) [pk] }
}

// ---- Projects / Director / Player ----

Table project_definition {
  project_definition_id varchar [pk]
  eligibility_requirement_root_id varchar
  completion_requirement_root_id varchar
  abandonment_policy_id varchar
}

Table project_instance {
  project_instance_id varchar [pk]
  run_id varchar
  project_definition_id varchar
  lifecycle varchar
}

// Director-owned opportunity lifecycle is named distinctly from event_definition.
Table directed_event_definition {
  directed_event_definition_id varchar [pk]
  eligibility_requirement_root_id varchar
  rarity_policy_id varchar
  cooldown_policy_id varchar
}

Table directed_event_instance {
  directed_event_instance_id varchar [pk]
  run_id varchar
  directed_event_definition_id varchar
  lifecycle varchar
  started_at decimal
}

Table suggestion_window {
  suggestion_window_id varchar [pk]
  run_id varchar
  intention_pattern_id varchar
  count int
  opened_at decimal
  cooldown_state varchar
}

Table legacy_knowledge {
  player_profile_id varchar
  knowledge_id varchar
  indexes { (player_profile_id, knowledge_id) [pk] }
}

Table run_diary {
  run_id varchar [pk]
  player_profile_id varchar
  started_sequence bigint
  ended_sequence bigint [null]
  end_summary_repr varchar [null]
}

Table diary_record {
  diary_record_id varchar [pk]
  run_id varchar
  record_kind varchar
  event_definition_id varchar [null]
  chronology_order bigint
  data_repr varchar
  screenshot_ref varchar [null]
}

// ---- Action execution / committed occurrence ----

Table action_execution {
  action_execution_id varchar [pk]
  run_id varchar
  action_id varchar
  resolution_definition_id varchar
  elapsed decimal
  committed boolean
  outcome_emitted boolean
  completed boolean
  interrupted boolean
}

Table action_binding {
  action_execution_id varchar
  role_id varchar
  subject_kind varchar
  subject_id varchar
  indexes { (action_execution_id, role_id) [pk] }
}

Table action_outcome {
  outcome_id varchar [pk]
  action_execution_id varchar
  event_definition_id varchar
  classification varchar [null]
  consequence_severity varchar [null]
}

Table resolved_effect {
  resolved_effect_id varchar [pk]
  outcome_id varchar
  ordinal int
  effect_kind varchar
  subject_role_id varchar
  semantic_id varchar
  value_repr varchar [null]
  object_role_id varchar [null]
}

Table semantic_outcome_tag {
  outcome_id varchar
  tag_id varchar
  indexes { (outcome_id, tag_id) [pk] }
}

Table diagnostic_feedback {
  diagnostic_feedback_id varchar [pk]
  outcome_id varchar
  feedback_kind_id varchar
  payload_repr varchar [null]
}

Table world_event {
  world_event_id varchar [pk]
  run_id varchar
  outcome_id varchar [null]
  event_definition_id varchar
  simulation_order bigint
}

Table observed_event {
  observation_id varchar [pk]
  run_id varchar
  world_event_id varchar
  event_definition_id varchar
  accessible_role_repr varchar
  modality_repr varchar
}

// PerceptionResult / PerceptualEvidence / SemanticChangeSet / effective-profile
// caches are transient/reconstructible contracts and intentionally omitted as
// canonical persistent tables in this projection.

// ---- Principal references ----

Ref: entity_definition_property.property_id > property_definition.property_id
Ref: entity_instance.run_id > run_state.run_id
Ref: entity_instance.entity_type_id > entity_definition.entity_type_id
Ref: entity_state_override.entity_id > entity_instance.entity_id
Ref: entity_state_override.property_id > property_definition.property_id
Ref: wilson_world_state.run_id > run_state.run_id
Ref: world_relation.run_id > run_state.run_id
Ref: world_relation.relation_type_id > relation_definition.relation_type_id
Ref: relation_subject_kind.relation_type_id > relation_definition.relation_type_id
Ref: relation_object_kind.relation_type_id > relation_definition.relation_type_id
Ref: actor_runtime_state.entity_id > entity_instance.entity_id
Ref: actor_runtime_state.actor_profile_id > actor_profile_definition.actor_profile_id
Ref: body_condition.run_id > run_state.run_id
Ref: wilson_body_state.run_id > run_state.run_id
Ref: environment_state.run_id > run_state.run_id
Ref: environmental_process.run_id > run_state.run_id
Ref: action_role_definition.action_id > action_definition.action_id
Ref: action_resolution_definition.action_id > action_definition.action_id
Ref: action_resolution_definition.event_definition_id > event_definition.event_definition_id
Ref: action_resolution_effect.resolution_definition_id > action_resolution_definition.resolution_definition_id
Ref: event_perceptible_role.event_definition_id > event_definition.event_definition_id
Ref: event_modality.event_definition_id > event_definition.event_definition_id
Ref: assembly_slot_definition.assembly_definition_id > assembly_definition.assembly_definition_id
Ref: property_derivation_definition.output_property_id > property_definition.property_id
Ref: property_derivation_input.derivation_id > property_derivation_definition.derivation_id
Ref: property_derivation_input.property_id > property_definition.property_id
Ref: interaction_rule_definition.action_id > action_definition.action_id
Ref: transformation_definition.result_entity_type_id > entity_definition.entity_type_id
Ref: belief_entry.claim_key > epistemic_claim.claim_key
Ref: belief_entry.run_id > run_state.run_id
Ref: knowledge_claim_pattern.knowledge_id > knowledge_definition.knowledge_id
Ref: learned_semantic_interaction.knowledge_id > knowledge_definition.knowledge_id
Ref: association_entry.run_id > run_state.run_id
Ref: habit_entry.run_id > run_state.run_id
Ref: episode.run_id > run_state.run_id
Ref: wilson_drive_state.run_id > run_state.run_id
Ref: wilson_trait_profile.run_id > run_state.run_id
Ref: presence_relationship.run_id > run_state.run_id
Ref: intention_instance.run_id > run_state.run_id
Ref: project_instance.project_definition_id > project_definition.project_definition_id
Ref: project_instance.run_id > run_state.run_id
Ref: directed_event_instance.directed_event_definition_id > directed_event_definition.directed_event_definition_id
Ref: directed_event_instance.run_id > run_state.run_id
Ref: suggestion_window.run_id > run_state.run_id
Ref: legacy_knowledge.player_profile_id > player_profile.player_profile_id
Ref: legacy_knowledge.knowledge_id > knowledge_definition.knowledge_id
Ref: run_diary.player_profile_id > player_profile.player_profile_id
Ref: diary_record.run_id > run_diary.run_id
Ref: action_execution.run_id > run_state.run_id
Ref: action_execution.action_id > action_definition.action_id
Ref: action_execution.resolution_definition_id > action_resolution_definition.resolution_definition_id
Ref: action_outcome.action_execution_id > action_execution.action_execution_id
Ref: action_outcome.event_definition_id > event_definition.event_definition_id
Ref: resolved_effect.outcome_id > action_outcome.outcome_id
Ref: semantic_outcome_tag.outcome_id > action_outcome.outcome_id
Ref: diagnostic_feedback.outcome_id > action_outcome.outcome_id
Ref: world_event.run_id > run_state.run_id
Ref: world_event.event_definition_id > event_definition.event_definition_id
Ref: observed_event.run_id > run_state.run_id
Ref: observed_event.world_event_id > world_event.world_event_id
Ref: observed_event.event_definition_id > event_definition.event_definition_id
